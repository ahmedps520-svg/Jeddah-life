# Database (local SQLite file by default; use libsql://… with a token for Turso)
DATABASE_URL=file:./data/jeddah-life.db
# DATABASE_AUTH_TOKEN=

# Where uploaded photos are stored
UPLOAD_DIR=./data/uploads

# Public URL (sitemap, robots)
SITE_URL=http://localhost:3000

# Map style (defaults to OpenFreeMap Positron)
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# Optional: AI interpretation of search queries (rule-based search works without it)
# ANTHROPIC_API_KEY=
# SEARCH_AI_MODEL=claude-opus-5-5
# SEARCH_AI=off
# SEARCH_AI_TIMEOUT_MS=6000

# Optional: create or promote an administrator when running npm run setup / seed
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=
